# CYVRIX Integration Test Environment
# DO NOT use these values in production

# Database
DATABASE_URL=postgresql+asyncpg://cyvrix_test:cyvrix_test_password@localhost:5433/cyvrix_test
DATABASE_URL_SYNC=postgresql://cyvrix_test:cyvrix_test_password@localhost:5433/cyvrix_test

# Redis
REDIS_URL=redis://localhost:6380/0

# Authentication
SECRET_KEY=test-secret-key-for-integration-only-not-for-production
SESSION_TTL_SECONDS=3600

# Application
ENVIRONMENT=test
APP_URL=http://localhost:3001
API_URL=http://localhost:8001

# GitHub (mocked in tests)
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret

# LLM (mocked in tests)
OPENAI_API_KEY=test-openai-key
OPENAI_MODEL=gpt-4o-mini

# Worker
SCAN_TIMEOUT_MINUTES=5
